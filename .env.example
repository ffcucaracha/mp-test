# Forecast: Open-Meteo needs no secret.
WEATHER_PROVIDER=open_meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Plant analysis: demo, kindwise, gemini or plantvillage.
PLANT_HEALTH_PROVIDER=demo
CROP_HEALTH_API_KEY=
CROP_HEALTH_API_URL=https://crop.kindwise.com/api/v1/identification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PLANTVILLAGE_MODEL_DIR=./backend/models/plantvillage

# Company weather stations. Never commit actual credentials.
COMPANY_API_URL=
COMPANY_API_EMAIL=
COMPANY_API_PASSWORD=

# For PWA/APK builds outside Docker.
VITE_API_URL=http://localhost:8000
